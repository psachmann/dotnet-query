<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!--
      Every src/ package multi-targets net9.0 and net10.0 (Directory.Build.props at the repo root),
      so the tests do too — otherwise the net9.0 build ships with zero test coverage.
    -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
  </PropertyGroup>
</Project>
