{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "Fetchling.Core/bin/Release/net10.0/Fetchling.Core.dll",
            "Fetchling.Extensions.DependencyInjection/bin/Release/net10.0/Fetchling.Extensions.DependencyInjection.dll",
            "Fetchling.Blazor/bin/Release/net10.0/Fetchling.Blazor.dll",
            "Fetchling.Blazor.DevTools/bin/Release/net10.0/Fetchling.Blazor.DevTools.dll",
            "Fetchling.Mvvm/bin/Release/net10.0/Fetchling.Mvvm.dll"
          ]
        }
      ],
      "output": "api",
      "filter": "filterConfig.yml"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "filterConfig.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "llms.txt"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "template"
    ],
    "globalMetadata": {
      "_appName": "Fetchling",
      "_appTitle": "Fetchling",
      "_appLogoPath": "images/fetchling-icon.svg",
      "_appFaviconPath": "images/fetchling-icon.png",
      "_enableSearch": true,
      "pdf": false
    }
  }
}
