<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <Description>Blazor components (Suspense, Transition, QueryRefreshMonitor) for DotNetQuery</Description>
    <!-- RS0041: the Razor-generated BuildRenderTree overrides use oblivious reference
         types; the generated code is not ours to annotate. -->
    <NoWarn>$(NoWarn);RS0041</NoWarn>
    <TrackPublicApi>true</TrackPublicApi>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetQuery.Core\DotNetQuery.Core.csproj" />
  </ItemGroup>
</Project>
