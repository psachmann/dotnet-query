<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IsPublishable>true</IsPublishable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Compare each package against the last stable release and fail the build on an
    unintentional breaking change. Unlike the public API files below, this diffs the real
    assemblies against the package consumers actually installed, so it also catches breaks
    that only manifest on one target framework.

    The baseline is the last stable release, not the latest prerelease: it measures what breaks
    for someone upgrading from the version they run in production, and each project's
    CompatibilitySuppressions.xml then lists every intentional break of the upcoming major.
    Bump it after every stable release. A project that did not exist at the baseline overrides
    it in its own project file. An intentional break needs a suppression file (pack with
    -p:GenerateCompatibilitySuppressionFile=true to produce one).
  -->
  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.3.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!--
    All time access goes through the injected IScheduler so tests can drive virtual time; a stray
    DateTime.UtcNow or Thread.Sleep silently reintroduces wall-clock dependence that TestScheduler
    cannot control. BannedSymbols.txt makes that invariant mechanical instead of a review habit.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="All" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

  <!--
    Neither property below has a default: every project under src/ must set each one explicitly in
    its own .csproj, so opting out is a visible decision in the project that makes it rather than a
    silent consequence of omission. The guard target turns a forgotten property into a build error.

    TrackPublicApi tracks the public surface in PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt, so
    adding or removing a public member is a deliberate, reviewable edit. DevTools sets it false: it
    ships a drop-in debugging component rather than an API consumers program against, so tracking
    it buys no compat guarantee worth the Razor churn.

    IsAotCompatible turns on the trim, AOT, and single-file analyzers and stamps the assembly
    trimmable. Blazor WASM trims by default on release publish and MAUI/UNO consumers publish AOT,
    so a trim-unsafe construct otherwise surfaces as a runtime failure in a consumer's app instead
    of a build error in ours. DevTools sets it false: the cache inspector reflection-serializes
    arbitrary consumer data, which no source generation can make statically analyzable.
  -->
  <Target Name="RequireExplicitProjectProperties" BeforeTargets="Build;Pack">
    <Error
      Condition="'$(TrackPublicApi)' == ''"
      Text="'$(MSBuildProjectName)' must set &lt;TrackPublicApi&gt; explicitly (true or false) in its own project file; there is no default."
    />
    <Error
      Condition="'$(IsAotCompatible)' == ''"
      Text="'$(MSBuildProjectName)' must set &lt;IsAotCompatible&gt; explicitly (true or false) in its own project file; there is no default."
    />
  </Target>

  <ItemGroup Condition="'$(TrackPublicApi)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="All" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
